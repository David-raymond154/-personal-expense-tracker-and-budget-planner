# Server configuration
PORT=5000

# JWT secret — change this to a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret_string

# JWT expiry
JWT_EXPIRES_IN=7d

# Path to the SQLite database file (relative to the backend folder)
DATABASE_FILE=expense_tracker.db

# Allowed CORS origin (the frontend dev server)
CORS_ORIGIN=http://localhost:5173
